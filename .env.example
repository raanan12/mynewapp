# Copy to .env.local and fill in. Only EXPO_PUBLIC_* vars reach the app bundle,
# so never put a secret key here.

# Supabase. Leave empty to run the app fully on local device state.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Kesher (קשר סליקה) real integration needs NO client env vars:
#   - tokenization_page_id / project_number live in the public
#     `kesher_settings` Supabase table (see supabase/schema.sql), so they can
#     change without shipping a new build.
#   - KESHER_API_USERNAME / KESHER_API_PASSWORD are Edge Function secrets,
#     set with `supabase secrets set ...`, never in this file.

# Optional generic Kesher proxy, only used when Supabase is NOT configured
# (i.e. running fully outside Supabase, with the built-in manual card form).
# Once Supabase is set up above, top-ups go through the `kesher-charge` Edge
# Function instead and these are unused. Leave empty to use the sandbox.
EXPO_PUBLIC_KESHER_PROXY_URL=
EXPO_PUBLIC_KESHER_TERMINAL_ID=
